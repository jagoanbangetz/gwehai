{
  "name": "scout-ai-backend",
  "version": "1.0.0",
  "description": "Scout AI Backend API",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d ormconfig.ts",
    "migration:run": "ts-node src/scripts/run-migration.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d ormconfig.ts",
    "test:db": "ts-node src/scripts/test-db-connection.ts",
    "test:ledger": "ts-node src/scripts/test-ledger.ts",
    "db:up": "cd .. && docker-compose up -d postgres",
    "db:down": "cd .. && docker-compose down",
    "db:logs": "cd .. && docker-compose logs -f postgres",
    "db:status": "cd .. && docker-compose ps",
    "db:seed": "ts-node src/scripts/seed-points.ts 999999",
    "db:seed-model-options": "ts-node src/scripts/seed-model-options.ts",
    "db:seed-models": "ts-node src/scripts/seed-available-models.ts",
    "db:test-models": "ts-node src/scripts/test-and-remove-failed-models.ts",
    "db:test-pentest-models": "ts-node src/scripts/test-pentest-models.ts",
    "db:delete-all-data": "ts-node src/scripts/delete-all-data.ts",
    "db:delete-all-data:confirm": "ts-node src/scripts/delete-all-data.ts --confirm",
    "make-admin": "ts-node src/scripts/make-admin.ts",
    "set-plan": "ts-node src/scripts/set-plan.ts",
    "test:gwehai-api": "ts-node -r tsconfig-paths/register src/scripts/test-gwehai-api.ts",
    "generate-bearer-token": "ts-node -r tsconfig-paths/register src/scripts/generate-bearer-token.ts",
    "test:groq-request-response": "ts-node -r tsconfig-paths/register src/scripts/test-groq-request-response.ts"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "0.52.8",
    "@mariozechner/pi-ai": "0.52.8",
    "@mariozechner/pi-coding-agent": "0.52.8",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-ws": "^10.4.22",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^10.4.22",
    "ai": "^6.0.86",
    "axios": "^1.13.4",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "nodemailer": "^8.0.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.18.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^7.0.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm-ts-node-commonjs": "^0.3.20",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "test/unit/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
