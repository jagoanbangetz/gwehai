# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=gwehai
DB_PASSWORD=gwehai_dev_password
DB_DATABASE=gwehai_db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Google OAuth (Optional - for production)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Stripe (Optional - for production)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Environment
NODE_ENV=development

# Pentest tools (Docker)
# When set, exec runs commands inside this container instead of the host.
# Start the container with: docker compose up -d pentest-tools
PENTEST_TOOLS_CONTAINER_NAME=gwehai-pentest-tools

