# =============================================================================
# GwehAI Backend - Sample environment variables
# Copy this file to .env and fill in your values:
#   cp env.sample .env
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=gwehai
DB_PASSWORD=gwehai_dev_password
DB_DATABASE=gwehai_db

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Google OAuth (Sign in / Register / Connect with Google)
# Callback URL must be: {BACKEND_BASE}/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# -----------------------------------------------------------------------------
# Model Provider Selector (Auto, DeepSeek, OpenAI GPT5, Claude, Gemini)
# Auto uses DeepSeek. Set the API key(s) for the provider(s) you want to use. At least one required for chat.
# Get keys: DeepSeek/OpenAI/Anthropic from their dashboards; Gemini from https://aistudio.google.com/app/apikey
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: override default model ids (used when user picks a provider in the UI)
# Auto uses DeepSeek; DEFAULT_AUTO_MODEL and DEEPSEEK_MODEL_ID default to deepseek-chat.
# DEFAULT_AUTO_MODEL=deepseek-chat
# OPENAI_GPT5_MODEL_ID=gpt-5.1
# DEEPSEEK_MODEL_ID=deepseek-chat
# CLAUDE_MODEL_ID=claude-3-5-sonnet-20241022
# GEMINI_MODEL_ID=gemini-2.0-flash

# Optional: OpenAI base URL (e.g. for proxy or Azure)
# OPENAI_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# Cost management (token caps and debug)
# -----------------------------------------------------------------------------
# Max output tokens: decision-style (default 300), long answer (default 800)
# MAX_OUTPUT_TOKENS_DEFAULT=300
# MAX_OUTPUT_TOKENS_LONG=800
# Tool-call requests (pentest, etc.): when set, overrides max_tokens for generateWithTools
# so the model has room to return tool_calls. E.g. 15000 for Groq avoids tool_use_failed.
# MAX_OUTPUT_TOKENS_TOOLS=15000
# Input token budget: Auto provider (6000), paid providers (8000)
# MAX_INPUT_TOKENS_AUTO=6000
# MAX_INPUT_TOKENS_PAID=8000
# Set to true to log and return usage/cost meta per request
# COST_DEBUG=false

# -----------------------------------------------------------------------------
# Plans / Billing (optional)
# -----------------------------------------------------------------------------
# Set POINTS_ENABLED=true to deduct credits/points for model usage (chat & pentest).
# POINTS_ENABLED=true
# PLAN_MIGRATION_FROM_POINTS=false
# POINTS_FOR_ULTRA=10000
# POINTS_FOR_PRO_PLUS=5000
# POINTS_FOR_PRO=1000
# WORKER_SLOT_TTL_MS=7200000

# -----------------------------------------------------------------------------
# Mail (optional, for notifications)
# -----------------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@localhost
# APP_NAME=GwehAI
# Logo URL for emails (default: https://cdn.gweh.sh/logo.png if unset)
# LOGO_URL=https://cdn.gweh.sh/logo.png

# -----------------------------------------------------------------------------
# Pentest / Skills (optional)
# Skills are loaded from the local directory only (no URL). Default: workspace/skills.
# -----------------------------------------------------------------------------
# PENTEST_SKILLS_LOCAL_DIR=/opt/skills
# PENTEST_WORKSPACE=/app
